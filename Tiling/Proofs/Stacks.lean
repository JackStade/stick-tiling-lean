import Tiling.Proofs.StackedPairs

/-!
# Stacks of sticks

Building on `Tiling/Proofs/StackedPairs.lean`, this file formalises the next steps of the proof
of Lemma 4 of the paper:

* a stick belonging to two stacked pairs is stacked in the same direction in both, so the two
  pairs lean the same way (`StickTiling.leansLeft_iff_of_isStackedPair`,
  `StickTiling.leansRight_iff_of_isStackedPair`, and
  `StickTiling.not_leansLeft_leansRight_of_stacked`);
* the sticks of a tiling can be grouped into *stacks*: `StickTiling.SameStack` is the
  equivalence relation generated by "same stick" and "stacked pair", `StickTiling.Stack c` is
  the set of sticks in the stack of the stick through `c`, and these sets partition the sticks
  of the tiling (`StickTiling.stack_eq_of_mem_of_mem`);
* every stack contains at most `n` sticks (`StickTiling.stack_ncard_le`).

The bound on the height of a stack comes from the following argument (the paper's
Figure 7).  Fix a stack, and let `d` be the direction of its sticks.  For each stick `S` of the
stack the cell `frontCell d S` immediately beyond the end of `S` in the direction `d` is covered
by a stick whose axis is the direction `e` in which the stack is stacked
(`sameAxis_dir_nbr_ends_of_stackedBy`).  Moving one step up the stack translates `frontCell` by
`e`, and two parallel sticks may never meet end to end
(`StickTiling.mem_stickOf_nbr_of_sameAxis`), so all these cells belong to *one* stick, which has
only `n` cells.  As the map `S ↦ frontCell d S` is injective, the stack has at most `n` sticks.
-/

namespace StickPolyhex

/-- Two directions with a common axis span the same axis. -/
lemma sameAxis_of_sameAxis_of_sameAxis {a b v : HexDir} (h1 : SameAxis a v) (h2 : SameAxis b v) :
    SameAxis a b := by
  revert h1 h2; revert a b v; decide

namespace StickTiling

variable {n : ℕ} (T : StickTiling n)

/-! ### Two parallel sticks never meet end to end -/

/-- In a valid tiling, if the stick through `x` has axis `e` and the stick through the
neighbouring cell in direction `e` also has axis `e`, then these are the same stick: two parallel
sticks cannot meet end to end. -/
lemma mem_stickOf_nbr_of_sameAxis (hv : T.SatisfiesWeaveRules) {x : Hex} {e : HexDir}
    (hx : SameAxis e (T.dir x)) (hy : SameAxis e (T.dir (nbr x e))) :
    nbr x e ∈ T.stickOf x := by
  rcases hx with h | h
  · -- the stick through `x` points in the direction `e`
    by_cases hidx : T.idx x = n
    · exfalso
      have hne := T.dir_ne_of_idx_eq_length hv hidx
      rw [h] at hne
      rcases hy with h' | h'
      · exact hne.1 h'
      · exact hne.2 h'
    · have := T.nbr_dir_mem_stickOf x (lt_of_le_of_ne (T.idx_le x) hidx)
      rwa [h] at this
  · -- the stick through `x` points against `e`
    have he : e = (T.dir x).opp := by rw [h]; simp
    by_cases hidx : T.idx x = 1
    · exfalso
      have hne := T.dir_ne_of_idx_eq_one hv hidx
      have hnbr : nbr x (T.dir x).opp = nbr x e := by rw [he]
      rw [hnbr] at hne
      rcases hy with h' | h'
      · exact hne.2 (by rw [h']; exact he)
      · exact hne.1 (by rw [h', he]; simp)
    · have := T.nbr_dir_opp_mem_stickOf x (lt_of_le_of_ne (T.idx_pos x) (Ne.symm hidx))
      rwa [← he] at this

/-! ### The cell just beyond a stick -/

/-- The last cell of the stick through `x` in the direction `d` (which is assumed to be an axis
of the stick): the tail if the stick points along `d`, and the head if it points against `d`. -/
def endCell (d : HexDir) (x : Hex) : Hex := if T.dir x = d then T.tail x else T.head x

/-- The cell just beyond the stick through `x`, in the direction `d`. -/
def frontCell (d : HexDir) (x : Hex) : Hex := nbr (T.endCell d x) d

lemma endCell_mem_stickOf (hn : 0 < n) (d : HexDir) (x : Hex) :
    T.endCell d x ∈ T.stickOf x := by
  rw [endCell]
  split
  · exact T.tail_mem_stickOf hn x
  · exact T.head_mem_stickOf x

lemma frontCell_not_mem_stickOf (hn : 0 < n) {d : HexDir} {x : Hex}
    (hax : SameAxis d (T.dir x)) : T.frontCell d x ∉ T.stickOf x := by
  rcases hax with h | h
  · have : T.endCell d x = T.tail x := by rw [endCell, if_pos h]
    rw [frontCell, this]
    have hd : T.dir (T.tail x) = d := by rw [T.dir_tail hn x, h]
    have := T.nbr_dir_not_mem_stickOf (c := T.tail x) (T.idx_tail hn x)
    rw [hd] at this
    rwa [T.stickOf_eq_of_mem (T.tail_mem_stickOf hn x)] at this
  · have hne : T.dir x ≠ d := by
      rw [h]
      exact (by decide : ∀ a : HexDir, a.opp ≠ a) d
    have hcell : T.endCell d x = T.head x := by rw [endCell, if_neg hne]
    rw [frontCell, hcell]
    have hd : (T.dir (T.head x)).opp = d := by rw [T.dir_head x, h]; simp
    have := T.nbr_dir_opp_not_mem_stickOf (c := T.head x) (T.idx_head x)
    rw [hd] at this
    rwa [T.stickOf_eq_of_mem (T.head_mem_stickOf x)] at this

/-- The last cell of a stick in a given direction is the only cell of the stick whose neighbour
in that direction lies outside the stick. -/
lemma endCell_unique (hn : 0 < n) {d : HexDir} {x z : Hex} (hax : SameAxis d (T.dir x))
    (hz : z ∈ T.stickOf x) (hzd : nbr z d ∉ T.stickOf x) : z = T.endCell d x := by
  have hstick : T.stickOf z = T.stickOf x := T.stickOf_eq_of_mem hz
  have hdz : T.dir z = T.dir x := T.dir_of_mem_stickOf hz
  rcases hax with h | h
  · have hcell : T.endCell d x = T.tail x := by rw [endCell, if_pos h]
    have hidx : T.idx z = n := by
      by_contra hne
      exact hzd (by
        have := T.nbr_dir_mem_stickOf z (lt_of_le_of_ne (T.idx_le z) hne)
        rw [hdz, h, hstick] at this
        exact this)
    rw [mem_stickOf_iff] at hz
    obtain ⟨k, hk, rfl⟩ := hz
    have := T.cellOfStick_idx x k hk
    rw [hidx] at this
    rw [hcell, tail]
    congr 1
    omega
  · have hne : T.dir x ≠ d := by
      rw [h]; exact (by decide : ∀ a : HexDir, a.opp ≠ a) d
    have hcell : T.endCell d x = T.head x := by rw [endCell, if_neg hne]
    have hd : d = (T.dir z).opp := by rw [hdz, h]; simp
    have hidx : T.idx z = 1 := by
      by_contra hne'
      exact hzd (by
        have := T.nbr_dir_opp_mem_stickOf z (lt_of_le_of_ne (T.idx_pos z) (Ne.symm hne'))
        rw [← hd, hstick] at this
        exact this)
    rw [mem_stickOf_iff] at hz
    obtain ⟨k, hk, rfl⟩ := hz
    have := T.cellOfStick_idx x k hk
    rw [hidx] at this
    have hk0 : k = 0 := by omega
    subst hk0
    rw [hcell, cellOfStick]
    simp

/-- The cell beyond a stick depends only on the stick. -/
lemma endCell_congr (d : HexDir) {x y : Hex} (h : T.head x = T.head y) :
    T.endCell d x = T.endCell d y := by
  have hmem : x ∈ T.stickOf y := (T.mem_stickOf_iff_head_eq y x).2 h
  have hdir : T.dir x = T.dir y := T.dir_of_mem_stickOf hmem
  have htail : T.tail x = T.tail y := by
    rw [tail, tail, cellOfStick, cellOfStick, h, hdir]
  rw [endCell, endCell, hdir, htail, h]

lemma frontCell_congr (d : HexDir) {x y : Hex} (h : T.head x = T.head y) :
    T.frontCell d x = T.frontCell d y := by
  rw [frontCell, frontCell, T.endCell_congr d h]

lemma frontCell_head (d : HexDir) (x : Hex) : T.frontCell d (T.head x) = T.frontCell d x :=
  T.frontCell_congr d (T.head_head x)

/-- Distinct sticks have distinct cells beyond them. -/
lemma stickOf_eq_of_frontCell_eq (hn : 0 < n) {d : HexDir} {x y : Hex}
    (h : T.frontCell d x = T.frontCell d y) : T.stickOf x = T.stickOf y := by
  have hend : T.endCell d x = T.endCell d y := by
    have : nbr (T.endCell d x) d = nbr (T.endCell d y) d := h
    simpa [nbr] using this
  have hx := T.stickOf_eq_of_mem (T.endCell_mem_stickOf hn d x)
  have hy := T.stickOf_eq_of_mem (T.endCell_mem_stickOf hn d y)
  rw [hend] at hx
  rw [← hx, hy]

/-- Moving one step up a stack translates the cell beyond the stick by the stacking direction. -/
lemma frontCell_of_stackedBy (hn : 0 < n) {d e : HexDir} {x x' : Hex}
    (hax : SameAxis d (T.dir x)) (hst : T.StackedBy x x' e) :
    T.frontCell d x' = nbr (T.frontCell d x) e := by
  have hax' : SameAxis d (T.dir x') :=
    sameAxis_trans_axis hax.symm hst.2.1
  have himg := T.stickOf_eq_image_of_stackedBy hst
  set z := T.endCell d x with hz
  have hzmem : z ∈ T.stickOf x := T.endCell_mem_stickOf hn d x
  have hzout : nbr z d ∉ T.stickOf x := T.frontCell_not_mem_stickOf hn hax
  have hz'mem : nbr z e ∈ T.stickOf x' := hst.2.2 z hzmem
  have hz'out : nbr (nbr z e) d ∉ T.stickOf x' := by
    rw [himg]
    intro hmem
    simp only [Finset.mem_image] at hmem
    obtain ⟨w, hw, hwe⟩ := hmem
    have hw' : w = nbr z d := by
      have : nbr w e = nbr (nbr z d) e := by rw [hwe, nbr_comm]
      simpa [nbr] using this
    rw [hw'] at hw
    exact hzout hw
  have := T.endCell_unique hn hax' hz'mem hz'out
  rw [frontCell, ← this, frontCell, nbr_comm]

/-- The cell beyond a stick belonging to a stacked pair is covered by a stick whose axis is the
direction in which the pair is stacked. -/
lemma sameAxis_dir_frontCell_of_stackedBy (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {d e : HexDir}
    {x x' : Hex} (hax : SameAxis d (T.dir x)) (hst : T.StackedBy x x' e) :
    SameAxis e (T.dir (T.frontCell d x)) := by
  obtain ⟨htail, hhead⟩ := T.sameAxis_dir_nbr_ends_of_stackedBy hv hn hst
  rcases hax with h | h
  · have hcell : T.frontCell d x = nbr (T.tail x) (T.dir x) := by
      rw [frontCell, endCell, if_pos h, h]
    rw [hcell]
    exact htail
  · have hne : T.dir x ≠ d := by
      rw [h]; exact (by decide : ∀ a : HexDir, a.opp ≠ a) d
    have hcell : T.frontCell d x = nbr (T.head x) (T.dir x).opp := by
      rw [frontCell, endCell, if_neg hne, h]
      simp
    rw [hcell]
    exact hhead

/-! ### A stick lies in stacked pairs that all lean the same way -/

/-- **All the stacked pairs containing a given stick are stacked in the same direction.**
If a stick belongs to two stacked pairs, the two stacking directions span the same axis. -/
theorem sameAxis_of_stackedBy_of_stackedBy (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c c₁ c₂ : Hex}
    {e f : HexDir} (h1 : T.StackedBy c c₁ e) (h2 : T.StackedBy c c₂ f) : SameAxis e f :=
  sameAxis_of_sameAxis_of_sameAxis (T.sameAxis_dir_nbr_ends_of_stackedBy hv hn h1).1
    (T.sameAxis_dir_nbr_ends_of_stackedBy hv hn h2).1

/-- **A stick in two stacked pairs: the two pairs lean the same way (left).** -/
theorem leansLeft_iff_of_isStackedPair (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c c₁ c₂ : Hex}
    (h1 : T.IsStackedPair c c₁) (h2 : T.IsStackedPair c c₂) :
    (T.LeansLeft c c₁ ↔ T.LeansLeft c c₂) := by
  obtain ⟨e, he⟩ := h1
  obtain ⟨f, hf⟩ := h2
  have hax : SameAxis e f := T.sameAxis_of_stackedBy_of_stackedBy hv hn he hf
  have key : ∀ a u v : HexDir, SameAxis u v → (u = a + 2 ∨ u = a + 5) →
      (v = a + 2 ∨ v = a + 5) := by decide
  constructor
  · rintro ⟨e', hst', hl⟩
    rw [T.stackedBy_unique hn he hst'] at hax
    exact ⟨f, hf, key (T.dir c) e' f hax hl⟩
  · rintro ⟨f', hst', hl⟩
    rw [T.stackedBy_unique hn hf hst'] at hax
    exact ⟨e, he, key (T.dir c) f' e hax.symm hl⟩

/-- **A stick in two stacked pairs: the two pairs lean the same way (right).** -/
theorem leansRight_iff_of_isStackedPair (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c c₁ c₂ : Hex}
    (h1 : T.IsStackedPair c c₁) (h2 : T.IsStackedPair c c₂) :
    (T.LeansRight c c₁ ↔ T.LeansRight c c₂) := by
  obtain ⟨e, he⟩ := h1
  obtain ⟨f, hf⟩ := h2
  have hax : SameAxis e f := T.sameAxis_of_stackedBy_of_stackedBy hv hn he hf
  have key : ∀ a u v : HexDir, SameAxis u v → (u = a + 1 ∨ u = a + 4) →
      (v = a + 1 ∨ v = a + 4) := by decide
  constructor
  · rintro ⟨e', hst', hl⟩
    rw [T.stackedBy_unique hn he hst'] at hax
    exact ⟨f, hf, key (T.dir c) e' f hax hl⟩
  · rintro ⟨f', hst', hl⟩
    rw [T.stackedBy_unique hn hf hst'] at hax
    exact ⟨e, he, key (T.dir c) f' e hax.symm hl⟩

/-- **A stick cannot be in both a left-leaning and a right-leaning stacked pair.** -/
theorem not_leansLeft_leansRight_of_stacked (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c c₁ c₂ : Hex} :
    ¬ (T.LeansLeft c c₁ ∧ T.LeansRight c c₂) := by
  rintro ⟨⟨e, he, hle⟩, ⟨f, hf, hrf⟩⟩
  exact T.not_leansLeft_and_leansRight hn
    ⟨⟨e, he, hle⟩,
      (T.leansRight_iff_of_isStackedPair hv hn ⟨f, hf⟩ ⟨e, he⟩).1 ⟨f, hf, hrf⟩⟩

/-! ### Grouping the sticks into stacks -/

/-- One step along a stack: either the two cells lie on the same stick, or their sticks form a
stacked pair. -/
def StackStep (a b : Hex) : Prop := T.stickOf a = T.stickOf b ∨ T.IsStackedPair a b

/-- Two cells lie in the same stack when their sticks are joined by a chain of stacked pairs.
This is the equivalence relation generated by `StickTiling.StackStep`. -/
def SameStack (c c' : Hex) : Prop := Relation.ReflTransGen T.StackStep c c'

lemma stackStep_symm {a b : Hex} (h : T.StackStep a b) : T.StackStep b a := by
  rcases h with h | ⟨e, hst⟩
  · exact Or.inl h.symm
  · exact Or.inr ⟨e.opp, StackedBy.symm T hst⟩

lemma sameStack_refl (c : Hex) : T.SameStack c c := Relation.ReflTransGen.refl

lemma SameStack.trans {c c' c'' : Hex} (h : T.SameStack c c') (h' : T.SameStack c' c'') :
    T.SameStack c c'' := Relation.ReflTransGen.trans h h'

lemma SameStack.symm {c c' : Hex} (h : T.SameStack c c') : T.SameStack c' c :=
  letI : Std.Symm T.StackStep := ⟨fun _ _ h => T.stackStep_symm h⟩
  Std.Symm.symm (r := Relation.ReflTransGen T.StackStep) c c' h

/-- Lying in the same stack is an equivalence relation, so the sticks of a tiling are partitioned
into stacks. -/
theorem sameStack_equivalence : Equivalence T.SameStack :=
  ⟨T.sameStack_refl, fun h => SameStack.symm T h, fun h h' => SameStack.trans T h h'⟩

lemma sameStack_of_stickOf_eq {c c' : Hex} (h : T.stickOf c = T.stickOf c') : T.SameStack c c' :=
  Relation.ReflTransGen.single (Or.inl h)

lemma sameStack_of_isStackedPair {c c' : Hex} (h : T.IsStackedPair c c') : T.SameStack c c' :=
  Relation.ReflTransGen.single (Or.inr h)

/-- The stack containing the stick through `c`, as a set of sticks. -/
def Stack (c : Hex) : Set (Finset Hex) := {s | ∃ x, T.SameStack c x ∧ s = T.stickOf x}

lemma self_mem_stack (c : Hex) : T.stickOf c ∈ T.Stack c := ⟨c, T.sameStack_refl c, rfl⟩

lemma stack_eq_of_sameStack {c c' : Hex} (h : T.SameStack c c') : T.Stack c = T.Stack c' := by
  ext s
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, SameStack.trans T (SameStack.symm T h) hx, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, SameStack.trans T h hx, rfl⟩

/-- Two stacks that share a stick are equal: the stacks partition the sticks of the tiling. -/
theorem stack_eq_of_mem_of_mem {c c' : Hex} {s : Finset Hex} (h : s ∈ T.Stack c)
    (h' : s ∈ T.Stack c') : T.Stack c = T.Stack c' := by
  obtain ⟨x, hx, rfl⟩ := h
  obtain ⟨y, hy, hxy⟩ := h'
  have : T.SameStack c c' :=
    SameStack.trans T hx
      (SameStack.trans T (T.sameStack_of_stickOf_eq hxy) (SameStack.symm T hy))
  exact T.stack_eq_of_sameStack this

/-! ### Every stack has at most `n` sticks -/

/-- Along a stack, all sticks have the same axis, and the cells just beyond them (in a fixed
direction `d`) all belong to a single stick. -/
lemma sameAxis_and_frontCell_mem_of_sameStack (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c x : Hex}
    (h : T.SameStack c x) :
    SameAxis (T.dir c) (T.dir x) ∧
      T.frontCell (T.dir c) x ∈ T.stickOf (T.frontCell (T.dir c) c) := by
  induction h with
  | refl => exact ⟨sameAxis_self _, T.self_mem_stickOf _⟩
  | @tail b x hcb hbx ih =>
    obtain ⟨hax, hmem⟩ := ih
    rcases hbx with hstick | ⟨e, hst⟩
    · have hhead : T.head x = T.head b := by
        have : x ∈ T.stickOf b := by rw [hstick]; exact T.self_mem_stickOf x
        exact (T.mem_stickOf_iff_head_eq b x).1 this
      have hdir : T.dir x = T.dir b := by
        have : x ∈ T.stickOf b := by rw [hstick]; exact T.self_mem_stickOf x
        exact T.dir_of_mem_stickOf this
      refine ⟨by rw [hdir]; exact hax, ?_⟩
      rw [T.frontCell_congr (T.dir c) hhead]
      exact hmem
    · have haxx : SameAxis (T.dir c) (T.dir x) := sameAxis_trans_axis hax.symm hst.2.1
      refine ⟨haxx, ?_⟩
      have hstep : T.frontCell (T.dir c) x = nbr (T.frontCell (T.dir c) b) e :=
        T.frontCell_of_stackedBy hn hax hst
      have h1 : SameAxis e (T.dir (T.frontCell (T.dir c) b)) :=
        T.sameAxis_dir_frontCell_of_stackedBy hv hn hax hst
      have h2 : SameAxis e (T.dir (T.frontCell (T.dir c) x)) := by
        have := T.sameAxis_dir_frontCell_of_stackedBy hv hn haxx (StackedBy.symm T hst)
        exact (by decide : ∀ u v : HexDir, SameAxis u.opp v → SameAxis u v) e _ this
      have hin : nbr (T.frontCell (T.dir c) b) e ∈ T.stickOf (T.frontCell (T.dir c) b) :=
        T.mem_stickOf_nbr_of_sameAxis hv h1 (by rw [← hstep]; exact h2)
      rw [hstep]
      rw [T.stickOf_eq_of_mem hmem] at hin
      exact hin

/-- **All the stacked pairs occurring inside one stack are stacked in the same direction.** -/
theorem sameAxis_of_stackedBy_of_sameStack (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c x c₁ x₁ : Hex}
    {e f : HexDir} (hs : T.SameStack c x) (h1 : T.StackedBy c c₁ e)
    (h2 : T.StackedBy x x₁ f) : SameAxis e f := by
  obtain ⟨hax, hmem⟩ := T.sameAxis_and_frontCell_mem_of_sameStack hv hn hs
  have hdir : T.dir (T.frontCell (T.dir c) x) = T.dir (T.frontCell (T.dir c) c) :=
    T.dir_of_mem_stickOf hmem
  have he : SameAxis e (T.dir (T.frontCell (T.dir c) c)) :=
    T.sameAxis_dir_frontCell_of_stackedBy hv hn (sameAxis_self _) h1
  have hf : SameAxis f (T.dir (T.frontCell (T.dir c) c)) := by
    have := T.sameAxis_dir_frontCell_of_stackedBy hv hn hax h2
    rwa [hdir] at this
  exact sameAxis_of_sameAxis_of_sameAxis he hf

/-- **All the stacked pairs in one stack lean the same way.**  This is the statement of the
paper: a stack leans left, or it leans right. -/
theorem leansLeft_iff_of_sameStack (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c x c₁ x₁ : Hex}
    (hs : T.SameStack c x) (h1 : T.IsStackedPair c c₁) (h2 : T.IsStackedPair x x₁) :
    (T.LeansLeft c c₁ ↔ T.LeansLeft x x₁) := by
  obtain ⟨e, he⟩ := h1
  obtain ⟨f, hf⟩ := h2
  have hax : SameAxis e f := T.sameAxis_of_stackedBy_of_sameStack hv hn hs he hf
  have hdirs : SameAxis (T.dir c) (T.dir x) :=
    (T.sameAxis_and_frontCell_mem_of_sameStack hv hn hs).1
  have key : ∀ a b u v : HexDir, SameAxis a b → SameAxis u v →
      ((u = a + 2 ∨ u = a + 5) ↔ (v = b + 2 ∨ v = b + 5)) := by decide
  constructor
  · rintro ⟨e', hst', hl⟩
    rw [T.stackedBy_unique hn he hst'] at hax
    exact ⟨f, hf, (key (T.dir c) (T.dir x) e' f hdirs hax).1 hl⟩
  · rintro ⟨f', hst', hl⟩
    rw [T.stackedBy_unique hn hf hst'] at hax
    exact ⟨e, he, (key (T.dir c) (T.dir x) e f' hdirs hax).2 hl⟩

/-- **All the stacked pairs in one stack lean the same way**, right-leaning version. -/
theorem leansRight_iff_of_sameStack (hv : T.SatisfiesWeaveRules) (hn : 0 < n) {c x c₁ x₁ : Hex}
    (hs : T.SameStack c x) (h1 : T.IsStackedPair c c₁) (h2 : T.IsStackedPair x x₁) :
    (T.LeansRight c c₁ ↔ T.LeansRight x x₁) := by
  obtain ⟨e, he⟩ := h1
  obtain ⟨f, hf⟩ := h2
  have hax : SameAxis e f := T.sameAxis_of_stackedBy_of_sameStack hv hn hs he hf
  have hdirs : SameAxis (T.dir c) (T.dir x) :=
    (T.sameAxis_and_frontCell_mem_of_sameStack hv hn hs).1
  have key : ∀ a b u v : HexDir, SameAxis a b → SameAxis u v →
      ((u = a + 1 ∨ u = a + 4) ↔ (v = b + 1 ∨ v = b + 4)) := by decide
  constructor
  · rintro ⟨e', hst', hl⟩
    rw [T.stackedBy_unique hn he hst'] at hax
    exact ⟨f, hf, (key (T.dir c) (T.dir x) e' f hdirs hax).1 hl⟩
  · rintro ⟨f', hst', hl⟩
    rw [T.stackedBy_unique hn hf hst'] at hax
    exact ⟨e, he, (key (T.dir c) (T.dir x) e f' hdirs hax).2 hl⟩

/-- The heads of the sticks in the stack through `c`: a set of representatives for the sticks in
the stack. -/
def stackHeads (c : Hex) : Set Hex := {y | ∃ x, T.SameStack c x ∧ y = T.head x}

lemma frontCell_mapsTo_stackHeads (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) :
    ∀ y ∈ T.stackHeads c,
      T.frontCell (T.dir c) y ∈ (T.stickOf (T.frontCell (T.dir c) c) : Set Hex) := by
  rintro y ⟨x, hx, rfl⟩
  rw [T.frontCell_head]
  exact_mod_cast (T.sameAxis_and_frontCell_mem_of_sameStack hv hn hx).2

lemma frontCell_injOn_stackHeads (hn : 0 < n) (c : Hex) :
    Set.InjOn (T.frontCell (T.dir c)) (T.stackHeads c) := by
  rintro y1 ⟨x1, _, rfl⟩ y2 ⟨x2, _, rfl⟩ hfc
  have := T.stickOf_eq_of_frontCell_eq hn hfc
  have hmem : T.head x1 ∈ T.stickOf (T.head x2) := by
    rw [← this]; exact T.self_mem_stickOf _
  have := (T.mem_stickOf_iff_head_eq (T.head x2) (T.head x1)).1 hmem
  rwa [T.head_head, T.head_head] at this

lemma stackHeads_finite (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) : (T.stackHeads c).Finite := by
  refine Set.Finite.of_finite_image (f := T.frontCell (T.dir c)) ?_
    (T.frontCell_injOn_stackHeads hn c)
  exact Set.Finite.subset (T.stickOf (T.frontCell (T.dir c) c) : Set Hex).toFinite
    (Set.image_subset_iff.2 (T.frontCell_mapsTo_stackHeads hv hn c))

/-- **A stack contains at most `n` sticks**, counted through the heads of its sticks. -/
theorem stackHeads_ncard_le (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) :
    (T.stackHeads c).ncard ≤ n := by
  have h := Set.ncard_le_ncard_of_injOn (T.frontCell (T.dir c))
    (T.frontCell_mapsTo_stackHeads hv hn c) (T.frontCell_injOn_stackHeads hn c)
    (T.stickOf (T.frontCell (T.dir c) c) : Set Hex).toFinite
  rwa [Set.ncard_coe_finset, T.card_stickOf] at h

lemma stack_eq_image_stackHeads (c : Hex) :
    T.Stack c = (fun y => T.stickOf y) '' T.stackHeads c := by
  ext s
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨T.head x, ⟨x, hx, rfl⟩, T.stickOf_eq_of_mem (T.head_mem_stickOf x)⟩
  · rintro ⟨y, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨T.head x, SameStack.trans T hx
      (T.sameStack_of_stickOf_eq (T.stickOf_eq_of_mem (T.head_mem_stickOf x)).symm), rfl⟩

/-- **Every stack has at most `n` sticks.** -/
theorem stack_ncard_le (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) : (T.Stack c).ncard ≤ n := by
  rw [T.stack_eq_image_stackHeads c]
  exact le_trans (Set.ncard_image_le (T.stackHeads_finite hv hn c)) (T.stackHeads_ncard_le hv hn c)

/-- Every stack is a finite set of sticks. -/
theorem stack_finite (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) : (T.Stack c).Finite := by
  rw [T.stack_eq_image_stackHeads c]
  exact Set.Finite.image _ (T.stackHeads_finite hv hn c)

/-- **Every stack has at most `n` sticks**, stated with `Set.encard` so that the bound also
records that a stack is finite. -/
theorem stack_encard_le (hv : T.SatisfiesWeaveRules) (hn : 0 < n) (c : Hex) : (T.Stack c).encard ≤ n := by
  rw [← (T.stack_finite hv hn c).cast_ncard_eq]
  exact_mod_cast T.stack_ncard_le hv hn c

end StickTiling

end StickPolyhex
